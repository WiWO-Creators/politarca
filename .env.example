# Auth apagada: el sitio no tiene cuentas. No cambiar en Vercel.
VITE_AUTH_ENABLED=false

# Carta semanal — Resend (https://resend.com)
# 1. Crear cuenta y verificar el dominio politarca.com (DNS: SPF, DKIM, DMARC).
# 2. Pegar la API key en Vercel → Settings → Environment Variables.
RESEND_API_KEY=

# Remitente: tiene que ser un dominio verificado en Resend.
NEWSLETTER_FROM="el politarca <carta@politarca.com>"

# Copia interna de cada suscripción.
NEWSLETTER_NOTIFY=consultas@politarca.com

# Grok / xAI — afina las réplicas del Ágora (opcional).
# Sin clave, el lápiz de la casa recorta en local.
XAI_API_KEY=
XAI_MODEL=grok-3-mini

# Clave con la que wiwo.doom publica en este sitio.
# Sin esto el endpoint de escritura del contrato existe pero rechaza todo, y el
# manifest anuncia write:false, asi que el orquestador no ofrece este destino.
# La misma clave se carga en doom, en la pagina conectada.
WIWO_WRITE_TOKEN=

# Propiedad de Google Analytics que mide este sitio (GA4): G-Q14D9HN1DZ.
# Vacia = el sitio NO emite ningun script de medicion, ni en produccion ni en
# vista previa. Se deja vacia a proposito en el repositorio: con el
# identificador escrito aca, cada rama en revision mandaria sus visitas a la
# propiedad de verdad. En Vercel se carga SOLO en el entorno Production, y como
# es VITE_ se fija al compilar: crearla o cambiarla exige volver a desplegar.
VITE_GA_MEASUREMENT_ID=
